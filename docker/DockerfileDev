FROM node:24.21.0@sha256:3d27e5c11e5786e309ec3e03f93ae536eb36e6e5eb3714d5eb3300a36157add0

LABEL maintainer="Vertex Digital"

ENV TZ=America/Sao_Paulo \
    PATH=/var/www/html/node_modules/.bin:$PATH

WORKDIR /var/www/html/
COPY package*.json ./
RUN npm ci

COPY docker/pm2-logrotate-*.sh ./docker/
RUN ./docker/pm2-logrotate-install.sh

COPY . .

EXPOSE 3000 9229

CMD ["npm", "run", "start:pm2-dev"]
