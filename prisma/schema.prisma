// Database schema. After changing it, create a migration with
//   npx prisma migrate dev --name <description>
// (docs/DESENVOLVIMENTO.md)

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ---- game data (OpenDota constants) ----

model Hero {
  id            Int      @id @db.SmallInt
  // internal name, e.g. npc_dota_hero_antimage
  name          String   @unique
  localizedName String   @map("localized_name")
  primaryAttr   String   @map("primary_attr")
  roles         String[]

  @@map("heroes")
}

model Item {
  id          Int     @id @db.SmallInt
  // key used by the purchase log, e.g. "blink"
  name        String  @unique
  displayName String? @map("display_name")
  cost        Int?

  @@map("items")
}

model Ability {
  // OpenDota/Valve ability id (talents included)
  id          Int     @id
  // internal name, e.g. ancient_apparition_cold_feet
  name        String  @unique
  displayName String? @map("display_name")
  isTalent    Boolean @map("is_talent")

  @@map("abilities")
}

// talent tree of each hero: tier 1 to 4 (hero levels 10, 15, 20 and 25),
// two options per tier (slot 0 and 1)
model HeroTalent {
  heroId    Int @map("hero_id") @db.SmallInt
  abilityId Int @map("ability_id")
  tier      Int @db.SmallInt
  slot      Int @db.SmallInt

  @@id([heroId, abilityId])
  @@map("hero_talents")
}

model Patch {
  // OpenDota patch id (increases with each patch)
  id         Int      @id @db.SmallInt
  name       String
  releasedAt DateTime @map("released_at") @db.Timestamptz

  @@map("patches")
}

// ---- matches (public: PUBLIC_WINDOW_HOURS; pro: the current patch) ----

enum MatchSource {
  PRO
  PUBLIC

  @@map("match_source")
}

enum DetailsStatus {
  // waiting for GET /matches/{id}
  PENDING
  // final items, without the purchase order (match not parsed)
  FETCHED
  // final items and purchase order
  PARSED
  // gave up (not found or never parsed)
  FAILED

  @@map("details_status")
}

model Match {
  // OpenDota/Steam match id
  id              BigInt        @id
  source          MatchSource
  startTime       DateTime      @map("start_time") @db.Timestamptz
  duration        Int
  radiantWin      Boolean       @map("radiant_win")
  patchId         Int           @map("patch_id") @db.SmallInt
  avgRankTier     Int?          @map("avg_rank_tier") @db.SmallInt
  leagueId        Int?          @map("league_id")
  detailsStatus   DetailsStatus @default(PENDING) @map("details_status")
  detailsAttempts Int           @default(0) @map("details_attempts") @db.SmallInt
  // when the details can be requested (again)
  detailsAfter    DateTime      @default(now()) @map("details_after") @db.Timestamptz
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz
  players         MatchPlayer[]

  @@index([startTime])
  @@index([detailsStatus, detailsAfter])
  @@map("matches")
}

model MatchPlayer {
  matchId         BigInt      @map("match_id")
  // 0-4 radiant, 128-132 dire
  playerSlot      Int         @map("player_slot") @db.SmallInt
  heroId          Int         @map("hero_id") @db.SmallInt
  win             Boolean
  // copied from the match, so the stats read only this table
  source          MatchSource
  patchId         Int         @map("patch_id") @db.SmallInt
  startTime       DateTime    @map("start_time") @db.Timestamptz
  accountId       BigInt?     @map("account_id")
  kills           Int?        @db.SmallInt
  deaths          Int?        @db.SmallInt
  assists         Int?        @db.SmallInt
  // final inventory (item ids, without empty slots); empty until the details
  items           Int[]       @db.SmallInt
  neutralItemId   Int?        @map("neutral_item_id") @db.SmallInt
  // purchase order (parsed matches): item ids and their times (seconds)
  purchaseItems   Int[]       @map("purchase_items") @db.SmallInt
  purchaseTimes   Int[]       @map("purchase_times")
  // ability ids in the order they were leveled up (talents included)
  abilityUpgrades Int[]       @map("ability_upgrades")
  match           Match       @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@id([matchId, playerSlot])
  @@index([patchId, heroId])
  @@map("match_players")
}

// ---- statistics of the current patch (rebuilt by the worker) ----

model HeroStat {
  patchId   Int         @map("patch_id") @db.SmallInt
  source    MatchSource
  heroId    Int         @map("hero_id") @db.SmallInt
  matches   Int
  wins      Int
  updatedAt DateTime    @map("updated_at") @db.Timestamptz

  @@id([patchId, source, heroId])
  @@map("hero_stats")
}

// items in the final inventory of a hero
model HeroItemStat {
  patchId           Int         @map("patch_id") @db.SmallInt
  source            MatchSource
  heroId            Int         @map("hero_id") @db.SmallInt
  itemId            Int         @map("item_id") @db.SmallInt
  matches           Int
  wins              Int
  // first purchase time (parsed matches): sum and count, so the average can
  // combine sources
  purchaseTimeSum   BigInt      @map("purchase_time_sum")
  purchaseTimeCount Int         @map("purchase_time_count")

  @@id([patchId, source, heroId, itemId])
  @@map("hero_item_stats")
}

// heroes per day, source, rank and game duration: the meta page filters and
// trends read only this table (days of the current patch)
model HeroDailyStat {
  patchId        Int         @map("patch_id") @db.SmallInt
  // UTC day of the match start
  day            DateTime    @db.Date
  source         MatchSource
  // tens of the average rank tier (7 Divine, 8 Immortal); 0 for pro matches
  rankBracket    Int         @map("rank_bracket") @db.SmallInt
  // 0: under 35 minutes, 1: 35 to 50, 2: 50 or more
  durationBucket Int         @map("duration_bucket") @db.SmallInt
  heroId         Int         @map("hero_id") @db.SmallInt
  matches        Int
  wins           Int

  @@id([patchId, day, source, rankBracket, durationBucket, heroId])
  @@map("hero_daily_stats")
}

// hero with another hero in the same match: as enemies or allies (all
// matches with heroes, details not needed)
model HeroMatchupStat {
  patchId     Int         @map("patch_id") @db.SmallInt
  source      MatchSource
  heroId      Int         @map("hero_id") @db.SmallInt
  otherHeroId Int         @map("other_hero_id") @db.SmallInt
  // true: same team
  ally        Boolean
  matches     Int
  // wins of hero_id
  wins        Int

  @@id([patchId, source, heroId, otherHeroId, ally])
  @@map("hero_matchup_stats")
}

// first purchase of each item by a hero, per time bucket (parsed matches):
// 0 before the horn, then 5 minute windows (1: 0-5, 2: 5-10 ... 13: 60+)
model HeroItemTimingStat {
  patchId Int         @map("patch_id") @db.SmallInt
  source  MatchSource
  heroId  Int         @map("hero_id") @db.SmallInt
  itemId  Int         @map("item_id") @db.SmallInt
  bucket  Int         @db.SmallInt
  matches Int
  wins    Int
  // sum of the purchase times (seconds), for the average
  timeSum BigInt      @map("time_sum")

  @@id([patchId, source, heroId, itemId, bucket])
  @@map("hero_item_timing_stats")
}

// heroes by position, rank and day from the STRATZ API (ranked All Pick):
// the statistics by role of the meta page
model HeroPositionDailyStat {
  // UTC day
  day         DateTime @db.Date
  // 1 carry, 2 mid, 3 offlane, 4 support, 5 hard support
  position    Int      @db.SmallInt
  // tens of the rank tier (7 Divine, 8 Immortal)
  rankBracket Int      @map("rank_bracket") @db.SmallInt
  heroId      Int      @map("hero_id") @db.SmallInt
  matches     Int
  wins        Int

  @@id([day, position, rankBracket, heroId])
  @@map("hero_position_daily_stats")
}

// first 10 levels of abilities of a hero (comma separated ability ids, from
// the matches with details)
model HeroSkillBuildStat {
  patchId Int         @map("patch_id") @db.SmallInt
  source  MatchSource
  heroId  Int         @map("hero_id") @db.SmallInt
  build   String
  matches Int
  wins    Int

  @@id([patchId, source, heroId, build])
  @@map("hero_skill_build_stats")
}

// talents picked by each hero in ranked Divine and Immortal matches of the
// latest STRATZ week, in every position (0) and in each one (1 to 5)
model HeroTalentStat {
  heroId    Int      @map("hero_id") @db.SmallInt
  position  Int      @default(0) @db.SmallInt
  abilityId Int      @map("ability_id")
  matches   Int
  wins      Int
  updatedAt DateTime @map("updated_at") @db.Timestamptz

  @@id([heroId, position, abilityId])
  @@map("hero_talent_stats")
}

// ability names with the values filled in (STRATZ), e.g. "+200 Mana Void
// Radius" instead of "+{s:bonus_mana_void_aoe_radius} Mana Void Radius"
model AbilityDisplayName {
  abilityId   Int    @id @map("ability_id")
  displayName String @map("display_name")

  @@map("ability_display_names")
}

// first purchase of each item by a hero in a position, per minute (STRATZ,
// latest week, ranked Divine and Immortal; only the frequent cells)
model HeroRoleItemTiming {
  heroId   Int @map("hero_id") @db.SmallInt
  position Int @db.SmallInt
  itemId   Int @map("item_id") @db.SmallInt
  minute   Int @db.SmallInt
  matches  Int
  wins     Int

  @@id([heroId, position, itemId, minute])
  @@map("hero_role_item_timings")
}

// starting items bought by a hero in a position (STRATZ, latest week)
model HeroRoleStartingItem {
  heroId   Int @map("hero_id") @db.SmallInt
  position Int @db.SmallInt
  itemId   Int @map("item_id") @db.SmallInt
  matches  Int
  wins     Int

  @@id([heroId, position, itemId])
  @@map("hero_role_starting_items")
}
