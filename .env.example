# project environments (develop | production | ...)
APP_ENVIRONMENT="develop"
PORT="3000"

#SWAGGER
SWAGGER="true"

# log level: verbose | debug | log | warn | error | fatal
LOG_LEVEL="debug"

# CORS: comma separated allowed origins (empty allows any origin)
CORS_ORIGINS=""

# reverse proxy: "false", "true", the number of proxies in front of the app
# (e.g. "1" behind nginx or a load balancer) or a list of trusted addresses
TRUST_PROXY="false"

# rate limit: max requests per IP within the window (ms)
THROTTLE_TTL="60000"
THROTTLE_LIMIT="100"

# debugger port in development
DEBUG_PORT="9229"

# PM2: number of processes in production (1 | max)
PM2_INSTANCES="1"

# authentication (RS256)
# RSA key pair, base64 encoded: the private key signs the tokens and the public
# key validates them (other services can get it from /.well-known/jwks.json).
# ./setup.sh generates them; to generate manually:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out private.pem
#   openssl pkey -in private.pem -pubout -out public.pem
#   openssl base64 -A -in private.pem   (JWT_PRIVATE_KEY)
#   openssl base64 -A -in public.pem    (JWT_PUBLIC_KEY)
JWT_PRIVATE_KEY=""
JWT_PUBLIC_KEY=""
JWT_ISSUER="nestjs-base-project"
JWT_AUDIENCE="nestjs-base-project"
# access token lifetime in seconds (15 minutes)
JWT_EXPIRES_IN="900"
# refresh token lifetime in seconds (7 days)
JWT_REFRESH_EXPIRES_IN="604800"

# observability with @nestjs/observe (observe.nestjs.com): disabled while
# the key and the secret are empty, so no data leaves the application
OBSERVE_APP_KEY=""
OBSERVE_APP_SECRET=""
OBSERVE_SERVICE_ID="nestjs-base-project"

# production container limits (docker-compose.yml)
CPU_LIMIT="1"
MEMORY_LIMIT="1g"

# mongo db connection string
# DB_CONNECTION=""

# mail credentials
# MAIL_HOST=""
# MAIL_FROM_ADDRESS=""
# MAIL_FROM_NAME=""
# MAIL_USERNAME=""
# MAIL_PASSWORD=""
# MAIL_TYPE=""
# MAIL_PORT=""
