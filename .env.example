# project environments (develop | production | ...)
APP_ENVIRONMENT="develop"
PORT="3000"

#SWAGGER
SWAGGER="true"

# log level: verbose | debug | log | warn | error | fatal
LOG_LEVEL="debug"

# CORS: comma separated allowed origins (empty allows any origin)
CORS_ORIGINS=""

# reverse proxy: "false", "true", the number of proxies in front of the app
# (e.g. "1" behind nginx or a load balancer) or a list of trusted addresses
TRUST_PROXY="false"

# rate limit: max requests per IP within the window (ms)
THROTTLE_TTL="60000"
THROTTLE_LIMIT="100"

# debugger port in development
DEBUG_PORT="9229"

# PM2: number of processes in production (1 | max)
PM2_INSTANCES="1"

# authentication (RS256)
# RSA key pair, base64 encoded: the private key signs the tokens and the public
# key validates them (other services can get it from /.well-known/jwks.json).
# ./setup.sh generates them; to generate manually:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out private.pem
#   openssl pkey -in private.pem -pubout -out public.pem
#   openssl base64 -A -in private.pem   (JWT_PRIVATE_KEY)
#   openssl base64 -A -in public.pem    (JWT_PUBLIC_KEY)
JWT_PRIVATE_KEY=""
JWT_PUBLIC_KEY=""
JWT_ISSUER="dota-metrics"
JWT_AUDIENCE="dota-metrics"
# access token lifetime in seconds (15 minutes)
JWT_EXPIRES_IN="900"
# refresh token lifetime in seconds (7 days)
JWT_REFRESH_EXPIRES_IN="604800"

# observability with @nestjs/observe (observe.nestjs.com): disabled while
# the key and the secret are empty, so no data leaves the application
OBSERVE_APP_KEY=""
OBSERVE_APP_SECRET=""
OBSERVE_SERVICE_ID="dota-metrics"

# OpenDota API: without a key the limit is 60 requests/minute and 3000/day
OPENDOTA_API_URL="https://api.opendota.com/api"
OPENDOTA_API_KEY=""
# minimum time between requests (ms)
OPENDOTA_REQUEST_INTERVAL_MS="1100"

# match collection (worker process)
# days of matches kept in the database
MATCH_RETENTION_DAYS="30"
# minutes between the requests for the latest pro and public matches
PRO_MATCHES_INTERVAL_MINUTES="15"
PUBLIC_MATCHES_INTERVAL_MINUTES="5"
# minimum average rank of the public matches (tens: 7 Divine, 8 Immortal)
PUBLIC_MIN_RANK_TIER="70"
# match details requested per minute, at most (each one is a request)
DETAILS_PER_MINUTE="30"
# daily OpenDota requests kept for the match lists
OPENDOTA_DAILY_RESERVE="150"

# production container limits (docker-compose.yml)
CPU_LIMIT="1"
MEMORY_LIMIT="1g"

# database (PostgreSQL)
# credentials of the postgres container; ./setup.sh generates the password
POSTGRES_USER="dota"
POSTGRES_PASSWORD=""
POSTGRES_DB="dota_metrics"
# port exposed to the host in development (database clients)
POSTGRES_PORT="5432"
# connection used by the application and by Prisma: the host is the postgres
# service of docker-compose
DATABASE_URL=""
# production container limits (docker-compose.yml)
POSTGRES_CPU_LIMIT="1"
POSTGRES_MEMORY_LIMIT="1g"

# mail credentials
# MAIL_HOST=""
# MAIL_FROM_ADDRESS=""
# MAIL_FROM_NAME=""
# MAIL_USERNAME=""
# MAIL_PASSWORD=""
# MAIL_TYPE=""
# MAIL_PORT=""
