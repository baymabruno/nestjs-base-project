# Dota Metrics configuration. Copy to .env (./setup.sh install does it and
# generates the keys and passwords). Full reference: docs/CONFIGURACAO.md
#
# Who reads each variable:
#   [app]     API, worker and backfill (validated at startup: the process does
#             not start with an invalid value)
#   [compose] docker-compose, when the containers are created
#   [pm2]     PM2 (ecosystem.config.cjs), when the container starts
#   [setup]   ./setup.sh
# Applying a change: [app] and [pm2] restart the processes in development
# (./setup.sh restart dev); in production, and for [compose] in any
# environment, recreate the containers (./setup.sh start dev|prod), because
# docker-compose only reads the variables when it creates them.

# ---- application ----

# [app, setup] environment name. "production" enables JSON logs and disables
# the demo users; any other value (develop, staging...) keeps them
APP_ENVIRONMENT="develop"

# [app, compose] HTTP port of the API, inside the container and on the host
# (default 3000)
PORT="3000"

# [app, setup] "true" publishes the API documentation at /doc and /doc-json;
# keep "false" in production (default false)
SWAGGER="true"

# [app] minimum log level: verbose | debug | log | warn | error | fatal. Each
# level includes the more severe ones (default log; debug and verbose are
# verbose, for development only)
LOG_LEVEL="debug"

# [app, setup] origins allowed to call the API from a browser (CORS), comma
# separated, e.g. "https://app.example.com,https://admin.example.com". Empty
# allows any origin
CORS_ORIGINS=""

# [app] reverse proxies trusted to inform the client IP (X-Forwarded-For):
# "false" (none, default), "true" (any), the number of proxies in front of the
# app (e.g. "1" behind nginx or a load balancer) or a comma separated list of
# addresses/subnets. Without it, behind a proxy every request seems to come
# from the proxy and shares the same rate limit
TRUST_PROXY="false"

# [app] rate limit per client IP: at most THROTTLE_LIMIT requests within
# THROTTLE_TTL milliseconds (default 100 per 60000ms). The login has its own
# limit of 5 per minute. Each PM2 process counts separately
THROTTLE_TTL="60000"
THROTTLE_LIMIT="100"

# ---- website (web/) ----

# [compose] port of the website on the host (default 3002). The site calls the
# API through the docker-compose network, so it needs no API address here
WEB_PORT="3002"

# [compose] production only: CPU and memory limits of the website container
# (default 1 CPU and 512m)
WEB_CPU_LIMIT="1"
WEB_MEMORY_LIMIT="512m"

# ---- processes and containers ----

# [compose] development only: port of the Node.js debugger on the host
# (default 9229)
DEBUG_PORT="9229"

# [pm2] production only: number of API processes in the PM2 cluster, a number
# or "max" (one per CPU core). The worker always runs as a single process
# (default 1)
PM2_INSTANCES="1"

# [compose] production only: CPU and memory limits of the app container
# (default 1 CPU and 1g)
CPU_LIMIT="1"
MEMORY_LIMIT="1g"

# ---- authentication (JWT RS256) ----

# [app, setup] RSA key pair (at least 2048 bits), PEM encoded in base64 on a
# single line: the private key signs the tokens and the public key validates
# them (other services get it from /.well-known/jwks.json). The keys must be
# a pair and unique per environment. ./setup.sh generates them; manually:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out private.pem
#   openssl pkey -in private.pem -pubout -out public.pem
#   openssl base64 -A -in private.pem   (JWT_PRIVATE_KEY)
#   openssl base64 -A -in public.pem    (JWT_PUBLIC_KEY)
# Changing them invalidates every token already issued
JWT_PRIVATE_KEY=""
JWT_PUBLIC_KEY=""

# [app] issuer (iss) and audience (aud) written in the tokens and required
# when validating them (default dota-metrics). Changing them invalidates the
# tokens already issued
JWT_ISSUER="dota-metrics"
JWT_AUDIENCE="dota-metrics"

# [app] access token lifetime in seconds (default 900, 15 minutes). Keep it
# short: the client renews it with the refresh token
JWT_EXPIRES_IN="900"

# [app] refresh token lifetime in seconds (default 604800, 7 days)
JWT_REFRESH_EXPIRES_IN="604800"

# ---- observability ----

# [app] @nestjs/observe (observe.nestjs.com): traces, errors and logs. Only
# enabled when the key and the secret are both set; while empty, no data
# leaves the application. OBSERVE_SERVICE_ID names this service in the panel
# (default dota-metrics)
OBSERVE_APP_KEY=""
OBSERVE_APP_SECRET=""
OBSERVE_SERVICE_ID="dota-metrics"

# ---- OpenDota API ----

# [app] address of the API (default https://api.opendota.com/api)
OPENDOTA_API_URL="https://api.opendota.com/api"

# [app] optional API key (paid plan). Without it the limit is 60 requests per
# minute and 3000 per day, per IP
OPENDOTA_API_KEY=""

# [app] minimum time between two requests of the same process, in
# milliseconds (default 1100, just under 60 per minute). The client also
# waits a minute when the API reports 10 or fewer requests left in the minute
OPENDOTA_REQUEST_INTERVAL_MS="1100"

# [app] daily requests kept for the match lists: the match details stop when
# the requests left today reach it, and the backfill uses at most half of what
# is left above it (default 150)
OPENDOTA_DAILY_RESERVE="150"

# ---- STRATZ API (statistics by role) ----

# [app] address of the GraphQL API (default https://api.stratz.com/graphql)
STRATZ_API_URL="https://api.stratz.com/graphql"

# [app] token of the STRATZ API, free at https://stratz.com/api (log in with
# Steam). Optional: without it the statistics by role (positions 1 to 5) are
# not collected and the meta page shows them as unavailable
STRATZ_API_TOKEN=""

# [app] hours between the requests for the statistics by role; each one is a
# single request (default 6)
STRATZ_INTERVAL_HOURS="6"

# ---- match collection (worker) ----

# [app] days of matches kept in the database; older ones are deleted daily at
# 4 AM. Also the maximum period of ./setup.sh backfill (default 30)
MATCH_RETENTION_DAYS="30"

# [app] minutes between the requests for the latest pro matches (default 15)
# and public matches (default 5). Each request is one from the daily quota and
# brings up to 100 matches
PRO_MATCHES_INTERVAL_MINUTES="15"
PUBLIC_MATCHES_INTERVAL_MINUTES="5"

# [app] minimum average rank of the public matches, from 10 to 80: the tens
# are the medal (1 Herald, 2 Guardian, 3 Crusader, 4 Archon, 5 Legend,
# 6 Ancient, 7 Divine, 8 Immortal) and the units the stars. Lower values bring
# more matches, but less representative of the high level meta (default 70)
PUBLIC_MIN_RANK_TIER="70"

# [app] maximum match details (items and purchase order) requested per minute,
# one request each. The worker spreads the daily quota over the day and never
# goes above this value (default 30)
DETAILS_PER_MINUTE="30"

# [app] minutes between the statistics updates of the current patch
# (default 15)
STATS_INTERVAL_MINUTES="15"

# ---- database (PostgreSQL) ----

# [compose, setup] credentials of the postgres container. The database is
# created with them on the first start: changing them afterwards does not
# change the existing user (use ALTER USER). ./setup.sh generates the password
POSTGRES_USER="dota"
POSTGRES_PASSWORD=""
POSTGRES_DB="dota_metrics"

# [app, setup] connection used by the app and by Prisma, with the same user,
# password and database as above: postgresql://user:password@postgres:5432/db
# ("postgres" is the docker-compose service). Generated by ./setup.sh
DATABASE_URL=""

# [compose] development only: PostgreSQL port on the host, for database
# clients (default 5432)
POSTGRES_PORT="5432"

# [compose] production only: CPU and memory limits of the postgres container
# (default 1 CPU and 1g)
POSTGRES_CPU_LIMIT="1"
POSTGRES_MEMORY_LIMIT="1g"

# ---- Metabase (development, ./setup.sh metabase) ----

# [compose] Metabase port on the host (default 3001)
METABASE_PORT="3001"

# [setup] login of the Metabase admin, created on the first run. Generated by
# ./setup.sh metabase, which logs in with them on the next runs: to change the
# password, change it in Metabase and here
METABASE_ADMIN_EMAIL=""
METABASE_ADMIN_PASSWORD=""

# [setup] password of metabase_reader, the read-only database user of
# Metabase. Generated by ./setup.sh metabase; running it again applies a new
# value to the user and to the Metabase connection
METABASE_READER_PASSWORD=""
