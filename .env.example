# project environments (develop | production | ...)
APP_ENVIRONMENT="develop"
PORT="3000"

#SWAGGER
SWAGGER="true"

# log level: verbose | debug | log | warn | error | fatal
LOG_LEVEL="debug"

# CORS: comma separated allowed origins (empty allows any origin)
CORS_ORIGINS=""

# reverse proxy: "false", "true", the number of proxies in front of the app
# (e.g. "1" behind nginx or a load balancer) or a list of trusted addresses
TRUST_PROXY="false"

# rate limit: max requests per IP within the window (ms)
THROTTLE_TTL="60000"
THROTTLE_LIMIT="100"

# debugger port in development
DEBUG_PORT="9229"

# PM2: number of processes in production (1 | max)
PM2_INSTANCES="1"

# authentication
# generate a strong key with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# (production requires at least 32 characters)
JWT_KEY="change-me"
JWT_EXPIRES_IN="28800"

# mongo db connection string
# DB_CONNECTION=""

# mail credentials
# MAIL_HOST=""
# MAIL_FROM_ADDRESS=""
# MAIL_FROM_NAME=""
# MAIL_USERNAME=""
# MAIL_PASSWORD=""
# MAIL_TYPE=""
# MAIL_PORT=""
